# Development defaults. Never commit real secrets. Override per environment.
APP_NAME=Car Ticket Booking API
ENVIRONMENT=development
DEBUG=true

# Postgres (production / docker). For local dev without Postgres use the SQLite URL.
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/car_tickets
# DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*

APP_TIMEZONE=Asia/Yangon

# Booking rules
SEAT_RESERVATION_TIMEOUT_MINUTES=10
BOOKING_EXPIRY_MINUTES=15
BOOKING_FEE_PERCENT=0
CANCELLATION_CUTOFF_HOURS=2

# Payments. MOCK is DEVELOPMENT ONLY and is rejected in production.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true
WEBHOOK_SECRET=change-me-webhook-secret

KBZPAY_MERCHANT_ID=
KBZPAY_SECRET_KEY=
WAVEPAY_MERCHANT_ID=
WAVEPAY_SECRET_KEY=
CBPAY_MERCHANT_ID=
CBPAY_SECRET_KEY=
BANK_TRANSFER_ACCOUNT=

TICKET_SINGLE_USE=true

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10